{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Memory Bee bundle v1",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "format_version": {
      "const": 1
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "agent": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": [
            "string",
            "null"
          ]
        },
        "session_id": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "agent",
        "version",
        "session_id"
      ]
    },
    "project": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "remote": {
          "type": [
            "string",
            "null"
          ]
        },
        "branch": {
          "type": [
            "string",
            "null"
          ]
        },
        "base_commit": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^([0-9a-f]{40}|[0-9a-f]{64})$"
        },
        "dirty": {
          "type": [
            "boolean",
            "null"
          ]
        }
      },
      "required": [
        "remote",
        "branch",
        "base_commit",
        "dirty"
      ]
    },
    "code_state": {
      "enum": [
        "base-reference",
        "changes-included",
        "unknown"
      ]
    },
    "files": {
      "type": "array",
      "minItems": 2,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1
          },
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "purpose": {
            "enum": [
              "entrypoint",
              "history",
              "patch",
              "new-file"
            ]
          }
        },
        "required": [
          "path",
          "sha256",
          "purpose"
        ]
      }
    },
    "omissions": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "warnings": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "redaction": {
      "enum": [
        "pending-review",
        "reviewed"
      ]
    }
  },
  "required": [
    "format_version",
    "created_at",
    "source",
    "project",
    "code_state",
    "files",
    "omissions",
    "warnings",
    "redaction"
  ]
}
